@model IEnumerable<Libro>
@{
    ViewData["Title"] = "Buscar por autor";
}

<h2>Buscar libros por autor</h2>

<form asp-action="PorAutor" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="autor" value="@ViewBag.Autor" class="form-control" placeholder="Nombre del autor" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
    </div>
</form>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-warning">@ViewBag.Mensaje</div>
}

<table class="table table-striped">
    <thead>
        <tr><th>Id</th><th>Libro</th><th>Autor</th><th>Editorial</th><th>ISDN</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.NombreLibro</td>
                <td>@item.Autor</td>
                <td>@item.NombreEditorial</td>
                <td>@item.ISDN</td>
            </tr>
        }
    </tbody>
</table>