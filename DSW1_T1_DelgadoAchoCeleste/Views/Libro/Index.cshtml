@model IEnumerable<Libro>
@{
    ViewData["Title"] = "Libros";
}

<h2>Mantenimiento de Libros</h2>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-info">@ViewBag.Mensaje</div>
}

<a asp-action="Crear" class="btn btn-primary mb-3">Registrar libro</a>
<a asp-action="PorAutor" class="btn btn-secondary mb-3">Buscar por autor</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Libro</th>
            <th>Autor</th>
            <th>Editorial</th>
            <th>ISDN</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.NombreLibro</td>
                <td>@item.Autor</td>
                <td>@item.NombreEditorial</td>
                <td>@item.ISDN</td>
                <td>
                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                    <form asp-action="Eliminar" method="post" class="d-inline"
                          onsubmit="return confirm('¿Seguro que desea eliminar este libro?');">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>